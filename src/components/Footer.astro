---
import { SITE } from '../site.config';
import { url } from '../lib/utils';

const { email, twitter, linkedin, github } = SITE.socials;
const icons = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  x: '<path d="M4 4l6.5 8.5L4 20h1.5l5.7-6.6L16 20h4l-6.8-9L19.5 4H18l-5.4 6.2L8 4z"/>',
  linkedin: '<path d="M8 11v5M8 8v.01M12 16v-5M16 16v-3a2 2 0 0 0-4 0"/><rect x="3" y="3" width="18" height="18" rx="3"/>',
  github: '<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
};
const links = [
  email && { href: `mailto:${email}`, label: 'Email', icon: icons.mail },
  twitter && { href: twitter, label: 'X', icon: icons.x },
  linkedin && { href: linkedin, label: 'LinkedIn', icon: icons.linkedin },
  github && { href: github, label: 'GitHub', icon: icons.github },
].filter(Boolean) as { href: string; label: string; icon: string }[];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-left caps">
      <span>{SITE.name} © {new Date().getFullYear()}</span>
      <a href={url('/rss.xml')}>RSS Feed</a>
      <a href={url('/tags')}>Tags</a>
      <button class="theme-btn caps" id="theme-toggle" aria-label="Toggle theme">
        Theme
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
    </div>
    <div class="footer-icons">
      {links.map((l) => (
        <a href={l.href} aria-label={l.label} title={l.label} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={l.icon} />
        </a>
      ))}
    </div>
  </div>
</footer>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
    const bar = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    if (bar) bar.content = dark ? '#000000' : '#ffffff';
  });
</script>
