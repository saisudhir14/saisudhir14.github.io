---
import { SITE, NAV } from '../site.config';
import { url } from '../lib/utils';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const home = url('/').replace(/\/$/, '');
const isActive = (href: string) => {
  if (href === '/') {
    const rest = path.slice(home.length) || '/';
    return rest === '/' || /^\/\d+$/.test(rest) || rest.startsWith('/blog') || rest.startsWith('/tags');
  }
  return path.startsWith(url(href));
};
const initial = SITE.name.trim()[0].toUpperCase();
---

<header class="site-header">
  <div class="wrap">
    <a href={url('/')} class="brand" aria-label="Home">
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <circle cx="16" cy="16" r="15" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <text x="16" y="21.5" text-anchor="middle" font-family="Noto Serif, Georgia, serif" font-size="16" fill="currentColor">{initial}</text>
      </svg>
      <span class="caps">{SITE.brand}</span>
    </a>
    <button class="menu-btn" id="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>
    <nav class="nav caps" id="nav">
      <button class="search-btn caps" data-open-search aria-label="Search">
        Search <kbd>⌘ K</kbd>
      </button>
      {NAV.map((item) => (
        <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const menu = document.getElementById('menu-toggle');
  menu?.addEventListener('click', () => {
    const open = document.getElementById('nav')!.classList.toggle('open');
    menu.setAttribute('aria-expanded', String(open));
  });
</script>
