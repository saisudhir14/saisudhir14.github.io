---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import { SITE } from '../site.config';
import { url } from '../lib/utils';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Set on blog posts so the page can be quoted as a BlogPosting. */
  published?: Date;
  modified?: Date;
  /** Set on the about page so the page can be quoted as a Person. */
  person?: boolean;
}

const { title, description = SITE.description, type = 'website', published, modified, person = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('/og.png'), Astro.site);
const siteRoot = new URL(url('/'), Astro.site).href;
const aboutUrl = new URL(url('/about/'), Astro.site).href;

const sameAs = [SITE.socials.linkedin, SITE.socials.github].filter(Boolean);
const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${siteRoot}#website`,
    name: SITE.name,
    url: siteRoot,
    description: SITE.description,
    inLanguage: 'en',
  },
];

if (person) {
  graph.push({
    '@type': 'Person',
    '@id': `${aboutUrl}#person`,
    name: SITE.name,
    jobTitle: SITE.profile.jobTitle,
    url: aboutUrl,
    worksFor: { '@type': 'Organization', name: SITE.profile.employer },
    homeLocation: { '@type': 'Place', name: SITE.profile.location },
    sameAs,
  });
}

if (published) {
  graph.push({
    '@type': 'BlogPosting',
    headline: title ?? SITE.title,
    description,
    datePublished: published.toISOString(),
    dateModified: (modified ?? published).toISOString(),
    author: { '@type': 'Person', name: SITE.name, url: aboutUrl },
    mainEntityOfPage: canonical.href,
    url: canonical.href,
    image: ogImage.href,
    inLanguage: 'en',
  });
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <meta name="apple-mobile-web-app-title" content={SITE.appName} />
    <meta name="theme-color" content="#000000" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Serif:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Dark by default. A saved choice from the footer toggle wins.
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        document.documentElement.classList.toggle('dark', t !== 'light');
        if (t === 'light') document.querySelector('meta[name="theme-color"]').content = '#ffffff';
      })();
    </script>
  </head>
  <body>
    <Header />
    <main class="wrap">
      <slot />
    </main>
    <Footer />
    <Search />
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ sw: url('/sw.js'), scope: url('/') }}>
        if ('serviceWorker' in navigator) {
          addEventListener('load', () => navigator.serviceWorker.register(sw, { scope }));
        }
      </script>
    )}
  </body>
</html>
