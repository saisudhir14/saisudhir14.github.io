---
import Base from '../../layouts/Base.astro';
import MonthIndex from '../../components/MonthIndex.astro';
import { getPosts, allTags, postToItem, slugify, url } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return allTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: { name: tag.name, posts: posts.filter((p) => p.data.tags.some((t) => slugify(t) === tag.slug)) },
  }));
}

const { name, posts } = Astro.props;
---

<Base title={name}>
  <a class="back" href={url('/tags')}>‹ Tags</a>
  <h1 class="page-title" style="margin-top:1.5rem">{name}</h1>
  <MonthIndex items={posts.map(postToItem)} />
</Base>
