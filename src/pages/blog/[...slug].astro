---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getPosts, readingTime, url } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const link = (p?: typeof post) => p && { title: p.data.title, href: url(`/blog/${p.id}`) };
---

<Article
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  updated={post.data.updated}
  minutes={readingTime(post.body)}
  tags={post.data.tags}
  headings={headings}
  back={{ label: 'Blog', href: url('/') }}
  older={link(older)}
  newer={link(newer)}
  posting
>
  <Content />
</Article>
